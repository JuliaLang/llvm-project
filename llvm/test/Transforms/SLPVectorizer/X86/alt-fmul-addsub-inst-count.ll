; CHECK-NEXT:    [[TMP0:%.*]] = load <2 x double>, ptr [[Z:%.*]], align 8
; CHECK-NEXT:    br label [[LOOP:%.*]]
; CHECK:       loop:
; CHECK-NEXT:    [[I:%.*]] = phi i64 [ 0, [[ENTRY:%.*]] ], [ [[I_NEXT:%.*]], [[LOOP]] ]
; CHECK-NEXT:    [[IDX_P:%.*]] = getelementptr inbounds i64, ptr [[IDX:%.*]], i64 [[I]]
; CHECK-NEXT:    [[K:%.*]] = load i64, ptr [[IDX_P]], align 8
; CHECK-NEXT:    [[W_P:%.*]] = getelementptr inbounds [2 x double], ptr [[W:%.*]], i64 [[I]]
; CHECK-NEXT:    [[WR:%.*]] = load double, ptr [[W_P]], align 8
; CHECK-NEXT:    [[WI_P:%.*]] = getelementptr inbounds i8, ptr [[W_P]], i64 8
; CHECK-NEXT:    [[WI:%.*]] = load double, ptr [[WI_P]], align 8
; CHECK-NEXT:    [[C_P:%.*]] = getelementptr inbounds [2 x double], ptr [[C:%.*]], i64 [[K]]
; CHECK-NEXT:    [[TMP1:%.*]] = load <2 x double>, ptr [[C_P]], align 8
; CHECK-NEXT:    [[TMP2:%.*]] = insertelement <2 x double> poison, double [[WI]], i64 0
; CHECK-NEXT:    [[TMP3:%.*]] = shufflevector <2 x double> [[TMP2]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP4:%.*]] = fmul contract <2 x double> [[TMP0]], [[TMP3]]
; CHECK-NEXT:    [[TMP5:%.*]] = shufflevector <2 x double> [[TMP4]], <2 x double> poison, <2 x i32> <i32 1, i32 0>
; CHECK-NEXT:    [[TMP6:%.*]] = fsub contract <2 x double> [[TMP5]], [[TMP1]]
; CHECK-NEXT:    [[TMP7:%.*]] = fadd contract <2 x double> [[TMP5]], [[TMP1]]
; CHECK-NEXT:    [[TMP8:%.*]] = shufflevector <2 x double> [[TMP6]], <2 x double> [[TMP7]], <2 x i32> <i32 0, i32 3>
; CHECK-NEXT:    [[TMP9:%.*]] = insertelement <2 x double> poison, double [[WR]], i64 0
; CHECK-NEXT:    [[TMP10:%.*]] = shufflevector <2 x double> [[TMP9]], <2 x double> poison, <2 x i32> zeroinitializer
; CHECK-NEXT:    [[TMP11:%.*]] = fmul contract <2 x double> [[TMP0]], [[TMP10]]
; CHECK-NEXT:    [[TMP12:%.*]] = fsub contract <2 x double> [[TMP11]], [[TMP8]]
; CHECK-NEXT:    [[TMP13:%.*]] = fadd contract <2 x double> [[TMP11]], [[TMP8]]
; CHECK-NEXT:    [[TMP14:%.*]] = shufflevector <2 x double> [[TMP12]], <2 x double> [[TMP13]], <2 x i32> <i32 0, i32 3>
; CHECK-NEXT:    store <2 x double> [[TMP14]], ptr [[C_P]], align 8
; CHECK-NEXT:    [[I_NEXT]] = add nuw nsw i64 [[I]], 1
; CHECK-NEXT:    [[DONE:%.*]] = icmp eq i64 [[I_NEXT]], [[N:%.*]]
