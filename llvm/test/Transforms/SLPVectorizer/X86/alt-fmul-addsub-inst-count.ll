  %k = load i64, ptr %idx.p, align 8
  %w.p = getelementptr inbounds [2 x double], ptr %w, i64 %i
  %wr = load double, ptr %w.p, align 8
  %wi.p = getelementptr inbounds i8, ptr %w.p, i64 8
  %wi = load double, ptr %wi.p, align 8
  %c.p = getelementptr inbounds [2 x double], ptr %c, i64 %k
  %cr = load double, ptr %c.p, align 8
  %ci.p = getelementptr inbounds i8, ptr %c.p, i64 8
  %ci = load double, ptr %ci.p, align 8
  %m1 = fmul contract double %zi, %wi
  %s1 = fsub contract double %m1, %cr
  %m2 = fmul contract double %zr, %wr
  %re = fsub contract double %m2, %s1
  %m3 = fmul contract double %zr, %wi
  %a1 = fadd contract double %m3, %ci
